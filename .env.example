# --- LLM (any OpenAI-compatible API) -----------------------------------------
LLM_API_KEY=
# OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
CHAT_MODEL=gpt-4o-mini

# --- Where the note is submitted ---------------------------------------------
SINK=webhook
WEBHOOK_URL=https://webhook.site/your-uuid

# SINK=notion
# NOTION_TOKEN=ntn_xxx
# The bare 32-hex id from the page URL, without the title slug or dashes:
# notion.so/My-Page-1a2b3c4d5e6f7890abcdef1234567890 -> the trailing 32 chars.
# NOTION_PARENT_PAGE_ID=1a2b3c4d5e6f7890abcdef1234567890

# --- Queue -------------------------------------------------------------------
# Uploads are spooled here and processed in the background; the directory is the
# queue, so jobs survive a restart. Size QUEUE_WORKERS to your LLM rate limit,
# and note QUEUE_MAX_DEPTH also caps disk use at depth x MAX_AUDIO_BYTES.
QUEUE_DIR=queue
QUEUE_WORKERS=2
QUEUE_MAX_DEPTH=100

# --- Server ------------------------------------------------------------------
ADDR=:8080
LOG_LEVEL=info
MAX_AUDIO_BYTES=26214400
PROCESS_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s
