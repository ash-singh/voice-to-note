# --- LLM (any OpenAI-compatible API) -----------------------------------------
LLM_API_KEY=sk-your-key
# OpenAI (default). For Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
CHAT_MODEL=gpt-4o-mini

# --- Where the note is submitted ---------------------------------------------
# webhook = POST the note as JSON anywhere (Zapier/Make -> Google Sheets, CRM,
#           https://webhook.site for a 30-second demo)
# notion  = create a page per voice memo under a parent page
SINK=webhook
WEBHOOK_URL=https://webhook.site/your-uuid

# SINK=notion
# NOTION_TOKEN=ntn_xxx
# NOTION_PARENT_PAGE_ID=1a2b3c4d5e6f7890abcdef1234567890

# --- Server ------------------------------------------------------------------
ADDR=:8080
LOG_LEVEL=info
MAX_AUDIO_BYTES=26214400
PROCESS_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s
